{
  "manifest_version": 3,
  "name": "CSFloat DB Sticker Linker created by Kina",
  "version": "0.1.0",
  "description": "Generate CSFloat DB links by sticker and float range.",
  "permissions": ["tabs", "scripting", "webRequest", "storage"],
  "host_permissions": ["*://csfloat.com/*"],
  "action": {
    "default_title": "CSFloat DB Sticker Linker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
